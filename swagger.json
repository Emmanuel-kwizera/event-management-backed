{
    "openapi": "3.0.0",
    "info": {
        "title": "Event Management API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summmary": "Register a new user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "fullName": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    },
                                    "gradeLevel": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summmary": "Login user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User logged in successfully"
                    }
                }
            }
        },
        "/api/events/create": {
            "post": {
                "tags": [
                    "Event"
                ],
                "summmary": "Create an event",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "date": {
                                        "type": "string"
                                    },
                                    "totalSeats": {
                                        "type": "integer"
                                    },
                                    "venue": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Event created successfully"
                    }
                }
            }
        },
        "/api/events/all": {
            "get": {
                "tags": [
                    "Event"
                ],
                "summmary": "Get all events",
                "responses": {
                    "200": {
                        "description": "List of events"
                    }
                }
            }
        },
        "/api/events/{name}": {
            "get": {
                "tags": [
                    "Event"
                ],
                "summmary": "Get event by name",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Event details"
                    }
                }
            }
        },
        "/api/events/{id}": {
            "put": {
                "tags": [
                    "Event"
                ],
                "summmary": "Update event by id",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "date": {
                                        "type": "string"
                                    },
                                    "totalSeats": {
                                        "type": "integer"
                                    },
                                    "venue": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Event updated successfully"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Event"
                ],
                "summmary": "Delete event by id",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Event deleted successfully"
                    }
                }
            }
        },
        "/api/tickets/create": {
            "post": {
                "tags": [
                    "Ticket"
                ],
                "summmary": "Create a ticket",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "userId": {
                                        "type": "string"
                                    },
                                    "eventId": {
                                        "type": "string"
                                    },
                                    "seatCount": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "201": {
                    "description": "Ticket created successfully"
                }
            }
        },
        "/api/tickets/all": {
            "get": {
                "tags": [
                    "Ticket"
                ],
                "summmary": "Get all tickets",
                "responses": {
                    "200": {
                        "description": "List of tickets"
                    }
                }
            }
        },
        "/api/tickets/{userId}": {
            "get": {
                "tags": [
                    "Ticket"
                ],
                "summmary": "Get ticket by id",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ticket details"
                    }
                }
            }
        },
        "/api/tickets/{id}": {
            "put": {
                "tags": [
                    "Ticket"
                ],
                "summmary": "Update ticket by id",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "userId": {
                                        "type": "string"
                                    },
                                    "eventId": {
                                        "type": "string"
                                    },
                                    "seatCount": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Ticket updated successfully"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Ticket"
                ],
                "summmary": "Delete ticket by id",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ticket deleted successfully"
                    }
                }
            }
        }
    }
}